# --- Bybit API (required) ---
# Get these from https://testnet.bybit.com → API Management
BYBIT_API_KEY=YOUR_BYBIT_TESTNET_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_TESTNET_API_SECRET

# --- Trading Pairs ---
# Semicolon-delimited: SOL/USDT;BTC/USDT
BYBIT_SYMBOLS=SOL/USDT

# --- Environment ---
# true = testnet (safe), false = mainnet (real money)
BYBIT_TESTNET=true
# true = paper trading simulation, false = real orders on exchange
SIM_MODE=false
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Risk (optional overrides) ---
# Enabled by default: 1.6% risk per trade, 20% max drawdown, 25% max exposure
# Set these if you want to override defaults
# SIM_MODE=true  # Set true to dry-run without placing real orders
